# Fetch all branches and their commit history
#git checkout master
git fetch --all

# Define the date 3 months ago
DATE_2_MONTHS_AGO=$(date --date="2 months ago" +%Y-%m-%d)


# Get all remote branches except master, release, and hotfix branches
branches=$(git branch -r --merged | grep -v -E "origin/(master|release|hotfix|stg1|stg2|stg3|stg4|stg5|Feature/develop)" | sed 's/origin\///')
#branches =$(git branch -r --merged)

# Iterate over each branch
for branch in $branches; do
  # Get the last commit date of the branch
  last_commit_date=$(git log -1 --format=%ci origin/$branch | cut -d ' ' -f 1)
  #year=$(date -d "$last_commit_date" +%Y)
  # Check if the branch is older than 2 months
  if [[ "$last_commit_date" < "$DATE_2_MONTHS_AGO" ]]; then
  #if [[  "$year" = "2021"  ]]; then
    # Delete the remote branch
    #git push origin --delete $branch
    echo $branch >> merged_branches_2_to_delete_.txt
    #else
    #echo omit $branch
  fi
  done